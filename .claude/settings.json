{
  "permissions": {
    "allow": [
      "Bash(fvm dart test *)",
      "Bash(fvm flutter test *)",
      "Bash(fvm dart analyze *)",
      "Bash(fvm flutter analyze *)",
      "Bash(fvm dart format *)"
    ],
    "deny": [
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-dart.sh"
          }
        ]
      }
    ]
  }
}
